# ── Required ──────────────────────────────────────────────────────────────────
MASTER_API_KEY=ib_changeme_use_a_long_random_string

# ── Cloudflare R2 (optional — for file storage & backups) ────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=iceberg-storage

# ── Email (optional — Resend.com, free 3000 emails/month) ────────────────────
RESEND_API_KEY=
EMAIL_FROM=Iceberg <hello@icebergdb.io>

# ── BYOC License (optional — for self-hosted enterprise) ─────────────────────
BYOC_LICENSE_KEY=
BYOC_MODE=false
