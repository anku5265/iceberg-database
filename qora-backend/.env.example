# ── Required ──────────────────────────────────────────────────────────────────
MASTER_API_KEY=qr_changeme_use_a_long_random_string

# ── Cloudflare R2 (optional — for file storage & backups) ────────────────────
# Get from: Cloudflare Dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=qora-storage

# ── BYOC License (optional — for self-hosted enterprise) ─────────────────────
BYOC_LICENSE_KEY=
BYOC_MODE=false
